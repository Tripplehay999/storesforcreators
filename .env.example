# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.
# Only the first three are required; every other feature switches itself off until its keys are set.

# ── Supabase (required) ── Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Public address of this site, used in emails and payment redirects. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase service key (server only, never NEXT_PUBLIC_) ──
# Needed for checkout (recording orders, download links) and the admin "Delete account" / "Confirm email" buttons.
SUPABASE_SERVICE_ROLE_KEY=

# ── Timezone for charts, greetings and discount-code end dates ── (default America/Toronto)
NEXT_PUBLIC_TIME_ZONE=America/Toronto

# ── Payments: Stripe ── Dashboard → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email: Resend ── resend.com → API Keys (EMAIL_FROM must use a domain you've verified there)
# Step-by-step: Admin → Emails in the app, or "Set up your email addresses" in the README.
RESEND_API_KEY=
EMAIL_FROM=Stores for Creators <hello@storesforcreators.com>
# Where replies to the app's emails go (forwarded to your inbox by Cloudflare Email Routing)
EMAIL_REPLY_TO=support@storesforcreators.com
# Comma-separated admin addresses for "new application" and "payout requested" alerts
ADMIN_EMAILS=

# ── Daily onboarding emails ── any long random text. Vercel sends it with the daily run (vercel.json)
# so nobody else can trigger it. Leave empty to keep the follow-up emails off.
CRON_SECRET=
# Optional: signs the Unsubscribe / Email settings links in emails. Defaults to the service role key.
EMAIL_LINK_SECRET=

# ── AI ideas and captions: Anthropic ── console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
